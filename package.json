{
  "name": "booking-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.spec.json --noEmit --pretty false",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "test:contract": "node scripts/contract-tests.mjs",
    "scan:production": "node scripts/scan-production-bundle.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:booking-web": "node dist/booking-web/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.8",
    "express": "5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.5.0",
    "eslint": "10.10.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
